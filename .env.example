# Copy to .env at the repository root (next to this file) and fill in. Never commit the real file.
# A real environment variable always wins over a value in .env.
# Comments go on their own lines so the file also works with Docker's --env-file.

# --- environment
# development | production. Production hides the demo OTP, the specimen loader and the customer "advance" button,
# and refuses to start without the three secrets below or with SYNTHETIC_IDENTIFIER_MODE=true.
APP_ENV=development

# --- secrets (generate fresh values; required when APP_ENV=production; leave empty in development)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOC_ENCRYPTION_KEY=
# keyed hash for mobile numbers: python -c "import secrets; print(secrets.token_hex(32))"
PII_PEPPER=

# --- storage (optional; the defaults below are used when these stay commented out)
# Relative paths are resolved from the backend/ directory, whatever directory the server is started from.
# DATA_DIR=../data/raw
# STORAGE_DIR=../storage
# DATABASE_URL=sqlite:///../storage/udyam.db
# PROPENSITY_MODEL_PATH=../ml/artifacts/propensity_model.joblib

# --- product rules
# midpoint | floor | ceiling of each catalogue price range
PRICE_POLICY=midpoint
GST_RATE=0.18
QUOTE_VALIDITY_DAYS=15
# The case's reference date for document-age checks. Leave empty to use today's date (production).
KYC_REFERENCE_DATE=2026-07-15
ADDRESS_PROOF_MAX_AGE_DAYS=90
# Accepts the competition's synthetic PAN (4th character X) and Udyam district 00. Must be false in production.
SYNTHETIC_IDENTIFIER_MODE=true

# --- demo-only helpers (ignored when APP_ENV=production)
DEMO_OTP=123456
DEMO_STAFF_PASSWORD=demo1234

# --- optional LLM provider for the advisor (the offline extractor is used when no key is set)
# auto | anthropic | openai | gemini | offline
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model names are optional overrides of the defaults in backend/app/config.py
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
